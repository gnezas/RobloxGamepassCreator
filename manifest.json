{
  "manifest_version": 3,
  "name": "Roblox Gamepass Creator",
  "short_name": "Pass Creator",
  "version": "1.3.1",
  "description": "Automatically create and list gamepasses for Roblox donation games with custom presets.",
  "author": "Andrew Zeng",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://apis.roblox.com/*"
  ],
  "action": {
    "default_title": "Roblox Gamepass Creator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.roblox.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "88",
  "offline_enabled": false
}
